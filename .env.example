# ==============================================================================
# Kurumsal ITSM AI Asistanı — Çevre Değişkenleri (Environment Variables)
# ==============================================================================
# Bu dosyayı '.env' olarak kopyalayıp kendi API anahtarlarınızı ekleyebilirsiniz.
# Not: API anahtarı girilmezse sistem otomatik olarak kural tabanlı hibrit RAG moduna geçer.

# 1. Google Gemini API Anahtarı (Opsiyonel - Gemini 3.5 Flash ile Dinamik Çözüm & Analiz)
# https://aistudio.google.com/ adresinden ücretsiz edinebilirsiniz.
GEMINI_API_KEY=

# 2. Groq API Anahtarı (Opsiyonel - Alternatif Yüksek Hızlı LLM)
# https://console.groq.com/ adresinden edinebilirsiniz.
GROQ_API_KEY=

# 3. LLM Entegrasyonu Aktif/Pasif (1 = Aktif, 0 = Pasif / Fallback RAG)
ASSISTANT_USE_LLM=1
