# ==============================================================================
# Kurumsal ITSM AI Asistanı — Çevre Değişkenleri
# ==============================================================================
# Bu dosyayı '.env' olarak kopyalayıp kendi API anahtarınızı ekleyin.
# Not: API anahtarı girilmezse sistem kural tabanlı hibrit RAG moduna geçer.

# NVIDIA Integrate API (Nemotron — OpenAI uyumlu)
# https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# LLM Entegrasyonu (1 = Aktif, 0 = Pasif)
ASSISTANT_USE_LLM=1

# Opsiyonel — HuggingFace embedding modeli için (indirme limiti / hız)
# HF_TOKEN=
